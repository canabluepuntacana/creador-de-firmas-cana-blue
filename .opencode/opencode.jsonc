{
  "$schema": "https://opencode.ai/config.json",
  // Project MCP servers for creador-de-firmas-cana-blue.
  // - github: official GitHub MCP (PAT via GITHUB_PAT; OAuth no soporta DCR).
  // - playwright: renders/tests the signature page in a real browser (needs Node.js).
  // - filesystem: scoped file access to this project (needs Node.js).
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PAT}"
        }
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      },
      "filesystem": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
        "cwd": "."
      }
    }
  }
}
